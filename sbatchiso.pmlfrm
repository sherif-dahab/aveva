------------------------------------------------------------------------
-- FIXED V4 - قراءة SupAllAncis بدون .size() (اللي كان بيرجع error)
-- بنجرب نقرا العناصر واحد واحد لحد ما يخلصوا 1..50
------------------------------------------------------------------------
setup form !!sbatchiso dialog docking size 20 20
	!!sbatchiso.formTitle = |Batch ISO Extraction|
    Para .batiso at X13 ymin + 0.5 text |Batch ISO Extraction App| Width 17
	Para .paralinelist at x0 ymax + 1 text |Select Line List| width 10
	button .btnBrowse at xmax + 1 ymin |Browse| callback |!!FILEBROWSER('c:\temp','*','Select Line List',TRUE,'!!sbatchiso.AddList()')|
	list .lstPipList |PIPE List|	anchor T+L	at x0  ymax+0.5 callback '!this.navigate()' MULTIPLE width 20 lines 8
    $(
	button.AddCE 		at xmax + 0.5 ymin + 1  LINKLABEL   |Add CE|	TOOLTIP 'Add Current Element'         callback |!This.AddCe()|
    button.AddCeMem 	at xmin ymin + 1   		LINKLABEL   |CE Mem|	TOOLTIP 'Add Current Element Members' callback |!This.AddCeMembers()|
    button.RemCE 		at xmin ymin + 1      	LINKLABEL   |Rem CE|	TOOLTIP 'Removes Selected Element'    callback |!This.RemoveSelected()|
    button.RemAll 		at xmin ymin + 1     	LINKLABEL   |Rem All|	TOOLTIP 'Clear All'                   callback |!this.ClearList()|
	button.CheckIso 	at xmin ymin + 1     	LINKLABEL   |Check Iso|	TOOLTIP 'Check Iso'       			  callback |!this.CheckIso()|
	$)
	button.AddCE 		at xmax + 0.5 ymin + 1  |Add CE|	TOOLTIP 'Add Current Element'         callback |!This.AddCe()|
    button.AddCeMem 	at xmin ymin + 1   		|CE Mem|	TOOLTIP 'Add Current Element Members' callback |!This.AddCeMembers()|
    button.RemCE 		at xmin ymin + 1      	|Rem CE|	TOOLTIP 'Removes Selected Element'    callback |!This.RemoveSelected()|
    button.RemAll 		at xmin ymin + 1     	|Rem All|	TOOLTIP 'Clear All'                   callback |!this.ClearList()|
	button.CheckIso 	at xmin ymin + 1     	|Check Iso|	TOOLTIP 'Check Iso'       			  callback |!this.CheckIso()|
	button.export 		at xmin ymin + 1     	|Export PCF|	TOOLTIP 'Export PCF'					  callback |!this.Export()|
	list .lstIsoOptList |ISO Option List|	anchor T+L	at x0  ymax.lstPipList + 1 single zeroSelection width 20 lines 8
	button.btnGenerate 	at x3 ymax + 1     	|Generate| TOOLTIP 'Generates Iso for all Pipes in List' callback |!this.generateIso()|
	button.btnDismiss 	at xmax + 5 ymin 	|Dismiss| TOOLTIP 'Dismiss the Form' callback |KILL !!sbatchiso|
	!!mangten = Array()
	Do !var from 1 to 9 by 1
		!tamthoi= '00' & !var
		!!mangten.append(!tamthoi)
	Enddo
	Do !var from 10 to 99 by 1
		!tamthoi= '0' & !var
		!!mangten.append(!tamthoi)
	Enddo
	!!space = Array()
	!!space.append(' ')
	Do !var from 2 to 50 by 1
		!!space.append(!!space[!var - 1] + ' ')
	Enddo
	!!lines  = array()
	member .boreFormat is format
    member .positionFormat is format
    member .angleFormat is format
exit

define method .sbatchiso()
	var !proj project code
	!isocode = !proj & 'iso'
	var !optionFileDir evar $!isocode
	!optFilesDir = object file('$!optionFileDir/std')
	!optfiles = !optFilesDir.files()
	!optFileNames = ARRAY()
	do !optFil values !optfiles
		!optFileNames.append(!optFil.entry())
	enddo
	!This.lstIsoOptList.dtext = !optFileNames
    !boreFormat  = object format()
    !boreFormat.dp = 6
    !boreFormat.units = 'INCH'
    !positionFormat = object format()
    !positionFormat.dp = 6
    !positionFormat.Dimension = 'L'
    !positionFormat.units = 'MM'
    !angleFormat  = object format()
    !angleFormat.dp = 0
    !angleFormat.Dimension = 'L'
    !this.boreFormat = !boreFormat
    !this.positionFormat = !positionFormat
    !this.angleFormat = !angleFormat
EndMethod

define method .generateIso()
	GETWORK
	if !this.lstPipList.count eq 0 then
		!!Alert.Warning(|Please Add Pipes.|)
		return
	endif
	if !this.lstIsoOptList.count eq 0 then
		!!Alert.Warning(|ISO Option file not available. contact Admin|)
		return
	endif
	if !this.lstIsoOptList.val eq 0 then
		!!Alert.Warning(|Select the ISO Option file.|)
		return
	endif
	!pipes = !this.lstPipList.selection()
	if !pipes.size() EQ 0 then
		!!Alert.Warning(|Please select Pipes.|)
		return
	endif
	!selFile = !this.lstIsoOptList.selection()
	var !proj project code
	!isocode = !proj & 'iso'
	var !optionFileDir evar $!isocode
	!optionFile = !optionFileDir & '/std/' & !selFile
	!tepx= object file(!optionFile)
	!file1 = object FILE('%PDMSUSER%' & '\STD\previewisostd.txt')
	if (!file1.exists().not()) then
		var !projectCode project code
		!projectFile = '%' & !projectCode & 'ISO%' & '\STD\previewisostd.txt'
		!file1 = object FILE(!projectFile)
		if (!file1.exists().not()) then
			!file1 = object FILE('%PDMSDFLTS%' & '\STD\previewisostd.txt')
		endif
	endif
	!xxx= !file1.fullname()
	!tenfile1= !xxx & '-xxx-old'
	!file1.move(!tenfile1)
	!tepx.copy(!xxx)
	!dongthu= 0
	!!donglenh= ''
	!fileObj = OBJECT FILE(!optionFile)
	!fileContent = !fileObj.Readfile()
	do !x from 1 to !fileContent.Size()
		if (!fileContent[!x].Matchwild('*File AND DXF*\*')) then
			!!donglenh= !fileContent[!x]
			!dongthu= !x
			!fileContent[!x]= 'File AND DXF  /%PDMSWK%/previewIsoStd  SINGLE'
			Break
		endif
	enddo
	!fileObj = OBJECT FILE(!xxx)
	!fileObj.Writefile('OVERWRITE',!fileContent)
	!resultArray = !!donglenh.Split('"')
	!!donglenh= !resultArray[2].Before('/') & '\'
	!!donglenh= !!donglenh.Replace('\\','\')
	!!tenchung= !resultArray[2].Replace('/','\')
	!!tenchung= !!tenchung.Replace('\\','\')
	!folderlog = !!tenchung.Split('\')
	!tenfolderlog= !folderlog[1] & '\'
	!sopt = !folderlog.Size() - 1
	do !x from 2 to !sopt
		!tenfolderlog= !tenfolderlog & !folderlog[!x] & '\'
	enddo
	!tenfilelog= !tenfolderlog & 'log.txt'
	!filelog = object FILE(!tenfilelog)
	!filelog.Open('OVERWRITE')
	if (!filelog.exists().not()) then
		!filelog = object FILE('D:\log.txt')
		!filelog.Open('OVERWRITE')
	endif
	ISODRAFTMODE
	handle any
	endhandle
	!failedLines = array()
	!kqpip= array()
	!kqso= array()
	!sopip= 0
	do !pip values !pipes
		!sopip= !sopip + 1
		$!pip
		!tenpip = '/' + !pip.After('/').Replace('"','').Replace('*','').Replace('\','').Replace('/','').Replace('|','').Replace('?','').Replace(':','').Replace('<','').Replace('>','')
		!!ten0 = !!donglenh + !tenpip
		if !tenpip.length() LT 50 then
			!tenpip= !tenpip + !!space[50 - !tenpip.length()]
		endif
		!kqpip.append(!tenpip)
		!so0 = 0
		!kqso.append(!so0)
		$m $!optionFile
		detail $!pip
		handle any
			!failedLines.append(!pip)
			skip
		endhandle
		Do !var value !!mangten
			!tentep= !!tenchung & !var
			!tep= object file(!tentep)
			if !tep.EXISTS() then
				!tenmoi= !!ten0 & '-Sh' & !var
				!tep.move(!tenmoi)
				!kqso[!sopip]= !kqso[!sopip] + 1
			else
				Break
			endif
			!tentep= !!tenchung & !var & '.dxf'
			!tep= object file(!tentep)
			if !tep.EXISTS() then
				!tenmoi= !!ten0 & '-Sh' & !var & '.dxf'
				!tep.move(!tenmoi)
			else
				Break
			endif
		Enddo
	enddo
	EXIT
	!!isdRunIso('STA', true)
	Do !var value !!mangten
		!tentep= !!tenchung & !var
		!tep= object file(!tentep)
		if !tep.EXISTS() then
			!tep.deletefile()
		else
			Break
		endif
		!tentep= !!tenchung & !var & '.dxf'
		!tep= object file(!tentep)
		if !tep.EXISTS() then
			!tep.deletefile()
		else
			Break
		endif
	Enddo
	!file1 = object FILE(!xxx)
	!file1.deletefile()
	!file1= object FILE(!tenfile1)
	!file1.move(!xxx)
	$p ISO extraction failed for the below Lines.
	q var !failedLines
	if !selFile eq 'TVM_STRESS' then
		pml load form !!caesariipcf
		!!caesariipcf.list.Clear()
		!!caesariipcf.list.dtext = !!sbatchiso.lstPipList.dtext
		!!caesariipcf.Export()
		!!Alert.Message('ISO Exctraction Completed & PCF files Generated Successfully.')
		return
	endif
	if !filelog.exists() then
		do !x from 1 to !sopip
			if !kqso[!x] EQ 0 then
				!filelog.Writerecord(!kqpip[!x] & 'fail')
			else
				!filelog.Writerecord(!kqpip[!x] & !kqso[!x] & ' sheet')
			endif
		enddo
	endif
	!filelog.close()
	!!Alert.Message('ISO Exctraction Completed Successfully.
	Folder is: ''$!tenfolderlog''')
EndMethod

define method .CheckIso()
	GETWORK
	!pipes = !this.lstPipList.selection()
	if !pipes.size() EQ 0 then
		!!Alert.Warning(|Please select Pipes.|)
		return
	endif
	if !this.lstIsoOptList.val eq 0 then
		!!Alert.Warning(|Select the ISO Option file.|)
		return
	endif
	!selFile = !this.lstIsoOptList.selection()
	var !proj project code
	!isocode = !proj & 'iso'
	var !optionFileDir evar $!isocode
	!optionFile = !optionFileDir & '/std/' & !selFile
	!tepx= object file(!optionFile)
	!file1 = object FILE('%PDMSUSER%' & '\STD\previewisostd.txt')
	if (!file1.exists().not()) then
		var !projectCode project code
		!projectFile = '%' & !projectCode & 'ISO%' & '\STD\previewisostd.txt'
		!file1 = object FILE(!projectFile)
		if (!file1.exists().not()) then
			!file1 = object FILE('%PDMSDFLTS%' & '\STD\previewisostd.txt')
		endif
	endif
	!xxx= !file1.fullname()
	!tenfile1= !xxx & '-xxx-old'
	!file1.move(!tenfile1)
	!tepx.copy(!xxx)
	ISODRAFTMODE
	handle any
	endhandle
	!failedLines = array()
	!pip = !this.lstPipList.selection()[1]
	$!pip
	EXIT
	!file1 = object FILE(!xxx)
	!file1.deletefile()
	!file1= object FILE(!tenfile1)
	!file1.move(!xxx)
	!dongthu= 0
	!!donglenh= ''
	!fileObj = OBJECT FILE(!optionFile)
	!fileContent = !fileObj.Readfile()
	do !x from 1 to !fileContent.Size()
		if (!fileContent[!x].Matchwild('*File AND DXF*\*')) then
			!!donglenh= !fileContent[!x]
			!dongthu= !x
			!fileContent[!x]= 'File AND DXF  /%PDMSWK%/previewIsoStd  SINGLE'
			Break
		endif
	enddo
	!fileObj = OBJECT FILE(!xxx)
	!fileObj.Writefile('OVERWRITE',!fileContent)
	!resultArray = !!donglenh.Split('"')
	!!tenchung= !resultArray[2].Replace('/','\')
	!!tenchung= !!tenchung.Replace('\\','\')
	!!isdRunIso('STA', true)
	Do !var value !!mangten
		!tentep= !!tenchung & !var
		!tep= object file(!tentep)
		if !tep.EXISTS() then
			!tep.deletefile()
		else
			Break
		endif
		!tentep= !!tenchung & !var & '.dxf'
		!tep= object file(!tentep)
		if !tep.EXISTS() then
			!tep.deletefile()
		else
			Break
		endif
	Enddo
EndMethod

Define Method .AddList()
	!FilNam = !!fileBrowser.file.string()
	!Fil = OBJECT FILE(!FilNam)
	!FileArr = !Fil.ReadFile()
	!PipeArr = object array()
	do !line values !FileArr
		if !line.substring(1,1) NEQ '/' and !line.substring(1,1) NEQ '=' then
			!line = '/' & !line
		endif
		!PipeArr.APPEND(!line)
	enddo
  !This.lstPipList.dtext = !PipeArr.unique()
EndMethod

Define Method .navigate()
	!mem = !this.lstPipList.selection()
	if !mem.size() NEQ 0 then
		$!mem[1]
	endif
EndMethod

Define Method .AddCeMembers()
    !MemList = !This.lstPipList.dtext
    if !!ce.Type NEQ 'ZONE' then
        !!Alert.Message(!!ce.Type & ' is Invalid Element. Valid Element Type ZONE.')
        return
    endif
    do !inx from 1 to !!ce.mcount()
		skip if(!!ce.mem[!inx].type neq 'PIPE')
         !MemList.append(!!ce.mem[!inx].name)
    enddo
   !This.lstPipList.dtext = !MemList.unique()
EndMethod

Define Method .AddCe()
	!MemList = !This.lstPipList.dtext
	if (!!CE.Type neq 'PIPE') then
		!!Alert.Warning(!!ce.Type & ' is invalid element. Valid element Type is PIPE.')
		return
	endif
	!MemList.append(!!CE.Name)
	!This.lstPipList.dtext =  !MemList.unique()
EndMethod

Define Method .RemoveSelected()
    if(!This.lstPipList.dtext.unset() and !This.lstPipList.dtext.empty())then
        return
    endif
	!pipes = !this.lstPipList.selection()
	if !pipes.size() EQ 0 then
		!!Alert.Warning(|Please select Pipes.|)
		return
	endif
	!pip1 = !this.lstPipList.selection()[1]
    !MemName = !This.lstPipList.dtext
	!MemName.deletefrom(!MemName.FindFirst(!pip1),1)
    !This.lstPipList.dtext = !MemName.COMPRESS()
EndMethod

Define Method .ClearList()
    !this.lstPipList.clear()
EndMethod

define method .Export(  )
	!!folderName = !!Alert.Input(|Enter Folder Path:|, |G:\PCF\|)
	if !!folderName.unset() or !!folderName eq || then
		!!Alert.Warning(|Folder not selected!|)
		return
	endif
	!!folderName = !!folderName.Replace(|/|, |\|)
	if !!folderName.Substring(!!folderName.Length(), 1) neq |\| then
		!!folderName = !!folderName & |\|
	endif
	!!namePCF = !!Alert.Input(|Enter the NAME OF PCF FILE if you want to combine into single file! Press OK if you want to keep separate files|, ||)
	!save = !!ce.fullname
	if !this.lstPipList.count eq 0 then
		!!Alert.Warning(|Please Add Pipes.|)
		return
	endif
	!pipes = !this.lstPipList.selection()
	if !pipes.size() EQ 0 then
		!!Alert.Warning(|Please select Pipes.|)
		return
	endif
	!folder = object file(!!folderName)
	if (!folder.exists() eq false) then
		syscom |MD "$!{!!folderName}"|
	endif
	!!lines.clear()
	!!lines.append(|ISOGEN-FILES            ISOGEN.FLS   |)
	!!lines.append(|UNITS-BORE              INCH         |)
	!!lines.append(|UNITS-CO-ORDS           MM           |)
	!!lines.append(|UNITS-BOLT-LENGTH       MM           |)
	!!lines.append(|UNITS-BOLT-DIA          INCH         |)
	!!lines.append(|UNITS-WEIGHT            KGS          |)
	do !pip values !pipes
		$!pip
		!this.Xuat()
	enddo
	if (!!namePCF neq ||) then
		!safeName = !!namePCF.Replace('"','').Replace('*','').Replace('\','').Replace('/','').Replace('|','').Replace('?','').Replace(':','').Replace('<','').Replace('>','')
		!pcfFileName = !!folderName & !safeName & |.pcf|
		!file = object file(!pcfFileName)
		!file.WriteFile(|OVERWRITE|, !!lines)
	endif
	$!save
	!!Alert.Message(|Export PCF File Successfully.|)
endmethod

------------------------------------------------------------------------
-- FIXED Xuat V4 - بدون .size() - نقرا مباشرة index 1..50
------------------------------------------------------------------------
define method .Xuat()
    !pip = !!CE

    !collection = object COLLECTION()
    !collection.addtype('BRAN')
    !collection.scope(!pip)
    !results  = !collection.results()
    !selected = object ARRAY()
    !selected.AppendArray(!results)
    !selected = !selected.unique()

    $* ================= السبورتات =================
    !supList = !this.GetSupports(!pip)

    !msg = 'PIPE: ' & !pip.Name & '  |  Supports found: ' & !supList.size().String()
    $p $!msg

    if(!!namePCF EQ '') then
        !!lines.clear()
        !!lines.append('ISOGEN-FILES            ISOGEN.FLS   ')
        !!lines.append('UNITS-BORE              INCH         ')
        !!lines.append('UNITS-CO-ORDS           MM           ')
        !!lines.append('UNITS-BOLT-LENGTH       MM           ')
        !!lines.append('UNITS-BOLT-DIA          INCH         ')
        !!lines.append('UNITS-WEIGHT            KGS          ')
    endif

    do !j index !selected
        !branDb   = !selected[!j]
        !itemName = !branDb.Name
        !!lines.append('PIPELINE-REFERENCE      $!itemName   ')

        !collection = object COLLECTION()
        !collection.addtype('BRAN MEM')
        !collection.scope(!branDb)
        !items = !collection.results()
        !find  = !items.FindFirst(!branDb)
        if(!find.Set()) then
            !items.removefrom(!find, 1)
        endif

        do !k index !items
            !component = !items[!k]
            !type      = !component.Type
            !result    = !this.$!<type>(!items, !k)
            if(!result.Empty()) then
                !test = !component.ppbore[2]
                skip if(!test.Unset())
                !result = !this.PCOM(!items, !k)
            else
                !!lines.AppendArray(!result)
            endif
        enddo
    enddo

    $* ================= كتابة السبورتات =================
    do !s index !supList
        !supDb = !supList[!s]
        skip if (!supDb.Type EQ 'ATTA')

        $* --- POSITION ---
        !posOK = TRUE
        !pos = !supDb.Pos.Wrt(WORLD)
        handle ANY
            !posOK = FALSE
        endhandle

        if (!posOK EQ FALSE) then
            !posOK = TRUE
            !pos = !supDb.Attpos.Wrt(WORLD)
            handle ANY
                !posOK = FALSE
            endhandle
        endif
        skip if (!posOK EQ FALSE)

        !x = !pos.East.String(!this.positionFormat)
        !y = !pos.North.String(!this.positionFormat)
        !z = !pos.Up.String(!this.positionFormat)

        $* --- BORE ---
        !bore = '16.000000'
        !bore = !pip.Hbore.String(!this.boreFormat)
        handle ANY
            !bore = '16.000000'
        endhandle

        $* --- SKEY ---
        !skeyVal = 'REST'
        !skeyVal = !supDb.Spref.Detref.Skey.String()
        handle ANY
            !skeyVal = 'REST'
        endhandle
        if (!skeyVal.Unset()) then
            !skeyVal = 'REST'
        endif
        if (!skeyVal EQ '') then
            !skeyVal = 'REST'
        endif

        !safeTag = !supDb.Name.Replace('"','')

        !!lines.append('SUPPORT')
        !!lines.append('    CO-ORDS    ' & !x & '  ' & !y & '  ' & !z & '  ' & !bore)
        !!lines.append('    SKEY       ' & !skeyVal)
        !!lines.append('    TAG        ' & !safeTag)
    enddo

    if(!!namePCF EQ '') then
        !safePipName = !pip.Name.Replace('"','').Replace('*','').Replace('\','').Replace('/','').Replace('|','').Replace('?','').Replace(':','').Replace('<','').Replace('>','')
        !pcfFileName = !!folderName & !safePipName & '.pcf'
        !file = object FILE(!pcfFileName)
        !file.WriteFile('OVERWRITE', !!lines)
    endif
endmethod

define method .getMaterial(!item is dbref) is array 
    !result = array()
    !tempArray = !item.spref.name.split('/')
    !itemCode = '    ITEM-CODE   ' + !tempArray.RemoveLast()
    !result.append(!itemCode)
    !description = '    ITEM-DESCRIPTION   ' + !item.dtxr
    !result.append(!description)
    !result.append('    WEIGHT    0.1')
    return !result
endmethod

define method .ELBO(!items is array, !index is real) is array
     !lines = array()
     !component = !items[!index]
     !lines.append('ELBOW')
     if(!index ne 1)then
        if(!items[!index - 1].type eq 'ATTA')then
			!arrivePosition = !component.apos.wrt(WORLD)
		else
			!arrivePosition = !items[!index - 1].lpos.wrt(WORLD)
		endif
     else
        !arrivePosition = !component.apos.wrt(WORLD)
     endif 
     !leavePosition = !component.lpos.wrt(WORLD)
     !arriveBore= !component.abore.string(!this.boreFormat)
     !leaveBore = !component.lbore.string(!this.boreFormat)
     !endPointArrive = !arrivePosition.east.string(!this.positionFormat) + '  ' + !arrivePosition.north.string(!this.positionFormat) + '  ' + !arrivePosition.up.string(!this.positionFormat) + '  ' + !arriveBore
     !endPointLeave = !leavePosition.east.string(!this.positionFormat) + '  ' + !leavePosition.north.string(!this.positionFormat) + '  ' + !leavePosition.up.string(!this.positionFormat) + '  ' + !leaveBore
     !lines.append('    END-POINT    $!endPointArrive ' )
     !lines.append('    END-POINT    $!endPointLeave ' )
     !centrePosition = !component.position.wrt(WORLD)
     !centrePoint = !centrePosition.east.string(!this.positionFormat) + '  ' + !centrePosition.north.string(!this.positionFormat) + '  ' + !centrePosition.up.string(!this.positionFormat) 
     !lines.append('    CENTRE-POINT     $!centrePoint ' )
     !lines.appendArray(!this.getMaterial(!component))
     !skey = !component.spref.detref.skey       
     if(!skey.set())then
        !lines.append('    SKEY  $!skey')
     endif  
     !angle = !component.angle * 100
     !strAngle = before(!angle.string(),'degree')
     !lines.append('    ANGLE  $!strAngle')
     return !lines
endmethod

define method .BEND(!items is array, !index is real) is array
     !lines = array()
     !component = !items[!index]
     !lines.append('BEND')
     if(!index ne 1)then
        if(!items[!index - 1].type eq 'ATTA')then
			!arrivePosition = !component.apos.wrt(WORLD)
		else
			!arrivePosition = !items[!index - 1].lpos.wrt(WORLD)
		endif
     else
        !arrivePosition = !component.apos.wrt(WORLD)
     endif 
     !leavePosition = !component.lpos.wrt(WORLD)
     !arriveBore= !component.abore.string(!this.boreFormat)
     !leaveBore = !component.lbore.string(!this.boreFormat)
     !endPointArrive = !arrivePosition.east.string(!this.positionFormat) + '  ' + !arrivePosition.north.string(!this.positionFormat) + '  ' + !arrivePosition.up.string(!this.positionFormat) + '  ' + !arriveBore
     !endPointLeave = !leavePosition.east.string(!this.positionFormat) + '  ' + !leavePosition.north.string(!this.positionFormat) + '  ' + !leavePosition.up.string(!this.positionFormat) + '  ' + !leaveBore
     !lines.append('    END-POINT    $!endPointArrive ' )
     !lines.append('    END-POINT    $!endPointLeave ' )
     !centrePosition = !component.position.wrt(WORLD)
     !centrePoint = !centrePosition.east.string(!this.positionFormat) + '  ' + !centrePosition.north.string(!this.positionFormat) + '  ' + !centrePosition.up.string(!this.positionFormat) 
     !lines.append('    CENTRE-POINT     $!centrePoint ' )
     !lines.appendArray(!this.getMaterial(!component))
     !skey = !component.spref.detref.skey       
     if(!skey.set())then
        !lines.append('    SKEY  $!skey')
     endif  
     !angle = !component.angle * 100
     !strAngle = !angle.string(!this.angleFormat)
     !lines.append('    ANGLE  $!strAngle')
     !raduis = !leavePosition.distance(!centrePosition).string(!this.positionFormat)
     !lines.append('    BEND-RADIUS  $!raduis')
     return !lines
endmethod

define method .TEE(!items is array, !index is real) is array
     !lines = array()
     !component = !items[!index]
     if(!component.ppos[1] eq !component.ppos[2])then
         !lines.append('TEE-SET-ON')
         if(!index ne 1)then
            if(!items[!index - 1].type eq 'ATTA')then
			!arrivePosition = !component.apos.wrt(WORLD)
		else
			!arrivePosition = !items[!index - 1].lpos.wrt(WORLD)
		endif
         else
            !arrivePosition = !component.apos.wrt(WORLD)
         endif 
         !position = !component.position.wrt(WORLD)
         !centrePoint = !position.east.string(!this.positionFormat) + ' ' + !position.north.string(!this.positionFormat) + ' ' + !position.up.string(!this.positionFormat)
         !lines.append('    CENTRE-POINT   $!centrePoint')
         !branchPosition = !component.ppos[3].wrt(WORLD)
         !branchBore = !component.ppbore[3].string(!this.boreFormat)
         !branchPoint = !branchPosition.east.string(!this.positionFormat) + ' ' + !branchPosition.north.string(!this.positionFormat) + ' ' + !branchPosition.up.string(!this.positionFormat) + '  ' + !branchBore
         !lines.append('    BRANCH1-POINT   $!branchPoint')
         !lines.appendArray(!this.getMaterial(!component))
         !skey = !component.spref.detref.skey       
         if(!skey.set())then
            !lines.append('    SKEY  $!skey')
         endif
         return !lines
     endif  
     !lines.append('TEE')
     if(!index ne 1)then
        if(!items[!index - 1].type eq 'ATTA')then
			!arrivePosition = !component.apos.wrt(WORLD)
		else
			!arrivePosition = !items[!index - 1].lpos.wrt(WORLD)
		endif
     else
        !arrivePosition = !component.apos.wrt(WORLD)
     endif 
     !arriveNumber = !component.arrive
     !position0 = !component.ppos[0].wrt(WORLD)
     !position1 = !component.ppos[1].wrt(WORLD)
     !position2 = !component.ppos[2].wrt(WORLD)
     !position3 = !component.ppos[3].wrt(WORLD)
     !position$!<arriveNumber> = !arrivePosition
     !bore1 = !component.ppbore[1].string(!this.boreFormat)
     !bore2 = !component.ppbore[2].string(!this.boreFormat)
     !bore3 = !component.ppbore[3].string(!this.boreFormat)
     !pos0 = !position0.east.string(!this.positionFormat) + '   ' +  !position0.north.string(!this.positionFormat) + '   ' +  !position0.up.string(!this.positionFormat) 
     !pos1 = !position1.east.string(!this.positionFormat) + '   ' +  !position1.north.string(!this.positionFormat) + '   ' +  !position1.up.string(!this.positionFormat) + '  ' + !bore1
     !pos2 = !position2.east.string(!this.positionFormat) + '   ' +  !position2.north.string(!this.positionFormat) + '   ' +  !position2.up.string(!this.positionFormat) + '  ' + !bore2
     !pos3 = !position3.east.string(!this.positionFormat) + '   ' +  !position3.north.string(!this.positionFormat) + '   ' +  !position3.up.string(!this.positionFormat) + '  ' + !bore3
     !lines.append('     END-POINT    $!pos1')
     !lines.append('     END-POINT    $!pos2')
     !lines.append('     CENTRE-POINT    $!pos0')
     !lines.append('     BRANCH1-POINT    $!pos3')
     !lines.appendArray(!this.getMaterial(!component))
     !skey = !component.spref.detref.skey       
     if(!skey.set())then
        !lines.append('    SKEY  $!skey')
     endif  
     return !lines
endmethod

define method .VALV(!items is array, !index is real) is array
     !lines = array()
      !component = !items[!index]
      !check = '2D 2Z AV AR AX'
      !checkArray = !check.split()
      !finder = !component.spref.detref.skey.substring(1,2)
      !test = !checkArray.FindFirst(!finder)
      if(!test.set())then
         !lines.append('VALVE-ANGLE')
         if(!index ne 1)then
            if(!items[!index - 1].type eq 'ATTA')then
			!arrivePosition = !component.apos.wrt(WORLD)
		else
			!arrivePosition = !items[!index - 1].lpos.wrt(WORLD)
		endif
         else
            !arrivePosition = !component.apos.wrt(WORLD)
         endif 
         !leavePosition = !component.lpos.wrt(WORLD)
         !arriveBore= !component.abore.string(!this.boreFormat)
         !leaveBore = !component.lbore.string(!this.boreFormat)
         !endPointArrive = !arrivePosition.east.string(!this.positionFormat) + '  ' + !arrivePosition.north.string(!this.positionFormat) + '  ' + !arrivePosition.up.string(!this.positionFormat) + '  ' + !arriveBore
         !endPointLeave = !leavePosition.east.string(!this.positionFormat) + '  ' + !leavePosition.north.string(!this.positionFormat) + '  ' + !leavePosition.up.string(!this.positionFormat) + '  ' + !leaveBore
         !lines.append('    END-POINT    $!endPointArrive ' )
         !lines.append('    END-POINT    $!endPointLeave ' )
         !centrePosition = !component.position.wrt(WORLD)
         !centrePoint = !centrePosition.east.string(!this.positionFormat) + '  ' + !centrePosition.north.string(!this.positionFormat) + '  ' + !centrePosition.up.string(!this.positionFormat) 
         !lines.append('    CENTRE-POINT     $!centrePoint ' )
        !lines.appendArray(!this.getMaterial(!component))
         !skey = !component.spref.detref.skey       
         if(!skey.set())then
            !lines.append('    SKEY  $!skey')
         endif  
         !lines.append('    CATEGORY  FIELD ')
     endif
     !check = 'NV KV VZ  ZB ZG VT VN VR VP VR VS VB VY VD VG VX VK VV VC CK'
     !checkArray = !check.split()
     !finder = !component.spref.detref.skey.substring(1,2)
     !test = !checkArray.FindFirst(!finder)
     if(!test.set())then
         !lines.append('VALVE')
         if(!index ne 1)then
            if(!items[!index - 1].type eq 'ATTA')then
			!arrivePosition = !component.apos.wrt(WORLD)
		else
			!arrivePosition = !items[!index - 1].lpos.wrt(WORLD)
		endif
         else
            !arrivePosition = !component.apos.wrt(WORLD)
         endif 
         !leavePosition = !component.lpos.wrt(WORLD)
         !arriveBore= !component.abore.string(!this.boreFormat)
         !leaveBore = !component.lbore.string(!this.boreFormat)
         !endPointArrive = !arrivePosition.east.string(!this.positionFormat) + '  ' + !arrivePosition.north.string(!this.positionFormat) + '  ' + !arrivePosition.up.string(!this.positionFormat) + '  ' + !arriveBore
         !endPointLeave = !leavePosition.east.string(!this.positionFormat) + '  ' + !leavePosition.north.string(!this.positionFormat) + '  ' + !leavePosition.up.string(!this.positionFormat) + '  ' + !leaveBore
         !lines.append('    END-POINT    $!endPointArrive ' )
         !lines.append('    END-POINT    $!endPointLeave ' )
        !lines.appendArray(!this.getMaterial(!component))
         !skey = !component.spref.detref.skey       
         if(!skey.set())then
            !lines.append('    SKEY  $!skey')
         endif  
     endif   
    !lines.append('    CATEGORY  ERECTION ')
     return !lines
endmethod

define method .REDU(!items is array, !index is real) is array
     !lines = array()
     !component = !items[!index]
     !checkString = 'CPBW CSBW CPFL CSFL RNSC RBSC RBSW'
     !checkArray = !checkString.split()
     if(!component.spref.detref.skey.substring(1,2) eq 'RC')then
        !type = 'REDUCER-CONCENTRIC'
     endif
     if(!checkArray.findfirst(!component.spref.detref.skey).set())then
         !type = 'REDUCER-CONCENTRIC'
     endif
     !checkString = 'EPBW ESBW EPFL ESFL RFPL RCGL RCPF RCFA RCCL REGL REPF REFA RECL'
     !checkArray = !checkString.split()
     if(!component.spref.detref.skey.substring(1,2) eq 'RE')then
        !type = 'REDUCER-ECCENTRIC'
     endif
     if(!checkArray.findfirst(!component.spref.detref.skey).set())then
         !type = 'REDUCER-ECCENTRIC'
     endif
     !lines.append(!type)
     if(!index ne 1)then
        if(!items[!index - 1].type eq 'ATTA')then
			!arrivePosition = !component.apos.wrt(WORLD)
		else
			!arrivePosition = !items[!index - 1].lpos.wrt(WORLD)
		endif
     else
        !arrivePosition = !component.apos.wrt(WORLD)
     endif 
     !leavePosition = !component.lpos.wrt(WORLD)
     !arriveBore= !component.abore.string(!this.boreFormat)
     !leaveBore = !component.lbore.string(!this.boreFormat)
     !endPointArrive = !arrivePosition.east.string(!this.positionFormat) + '  ' + !arrivePosition.north.string(!this.positionFormat) + '  ' + !arrivePosition.up.string(!this.positionFormat) + '  ' + !arriveBore
     !endPointLeave = !leavePosition.east.string(!this.positionFormat) + '  ' + !leavePosition.north.string(!this.positionFormat) + '  ' + !leavePosition.up.string(!this.positionFormat) + '  ' + !leaveBore
     !lines.append('    END-POINT    $!endPointArrive ' )
     !lines.append('    END-POINT    $!endPointLeave ' )
     !lines.appendArray(!this.getMaterial(!component))
     !skey = !component.spref.detref.skey       
     if(!skey.set())then
        !lines.append('    SKEY  $!skey')
     endif  
     return !lines
endmethod

