define method .Export(  )
	!save = !!ce.fullname
	if !this.lstPipList.count eq 0 then
		!!Alert.Warning(|Please Add Pipes.|)
		return
	endif
	
	!pipes = !this.lstPipList.selection()
	if !pipes.size() EQ 0 then
		!!Alert.Warning(|Please select Pipes.|)
		return
	endif

	-- فتح نفس الويندو الرسمية بتاعة AVEVA (زي الـ DXF)
	!initFolder = |C:\temp|
	!!filebrowser(!initFolder, |*.pcf|, |Open Target Folder and Click Save|, false, ||)

	!selectedPath = !!filebrowser.file.string()
	if !selectedPath.unset() or !selectedPath eq || then
		!!Alert.Warning(|No folder selected!|)
		return
	endif

	-- استخراج مسار الفولدر فقط من مسار الملف المختار
	!fileObj = OBJECT FILE(!selectedPath)
	!!folderName = !fileObj.directory().Replace(|/|, |\|)

	-- التأكد إن المسار ينتهي بـ \
	!bs = |\|
	if !!folderName.Substring(!!folderName.Length(), 1) neq !bs then
		!!folderName = !!folderName & !bs
	endif

    !folder = object file(!!folderName)
    if(!folder.exists() eq false)then
		syscom |MD "$!{!!folderName}"|
    endif

	-- تخلي اسم الملف فاضي عشان دالة Xuat تخرج كل خط في ملف منفصل باسمه الخاص
	!!namePCF = ||

	!!lines.clear()
	!!lines.append(|ISOGEN-FILES            ISOGEN.FLS   |)
	!!lines.append(|UNITS-BORE              INCH         |)
	!!lines.append(|UNITS-CO-ORDS           MM           |)
	!!lines.append(|UNITS-BOLT-LENGTH       MM           |)
	!!lines.append(|UNITS-BOLT-DIA          INCH         |)
	!!lines.append(|UNITS-WEIGHT            KGS          |)

	-- تصدير كل الخطوط في ملفات منفصلة بأسمائهم
	do !pip values !pipes
		$!pip
		!this.Xuat()
	enddo

	$!save
	!!Alert.Message(|PCF Files Exported Successfully!| & |$newline| & |Folder: | & !!folderName)
endmethod
