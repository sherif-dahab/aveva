Define Method .AddCeMembers()
    !MemList = !This.lstPipList.dtext

    if !!ce.Type NEQ 'ZONE' then
        !!Alert.Message(!!ce.Type & ' is Invalid Element. Valid Element Type ZONE.')
        return
    endif

    do !inx from 1 to !!ce.mcount()
		skip if(!!ce.mem[!inx].type neq 'PIPE')
         !MemList.append(!!ce.mem[!inx].name)
    enddo

   !This.lstPipList.dtext = !MemList.unique()
EndMethod

-----------------------------------------------------------------------

Define Method .AddCe()
	!MemList = !This.lstPipList.dtext

	if (!!CE.Type neq 'PIPE') then
		!!Alert.Warning(!!ce.Type & ' is invalid element. Valid element Type is PIPE.')
		return
	endif

	!MemList.append(!!CE.Name)
	!This.lstPipList.dtext =  !MemList.unique()
EndMethod

